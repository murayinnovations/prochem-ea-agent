# Copy to sync-agent/.env and fill in values.
# Used by the SAP B1 → Supabase sync worker (src/sync.ts, src/backfill-invoices.ts).

# Supabase (SUPABASE_URL is also accepted in place of NEXT_PUBLIC_SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# SAP Business One SQL Server
SAP_SQL_HOST=
SAP_SQL_PORT=1433
SAP_SQL_DATABASE=
SAP_SQL_USER=
SAP_SQL_PASSWORD=
